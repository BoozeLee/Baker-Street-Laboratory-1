# ============================================
# Baker Street Laboratory — Merged Environment
# ============================================

# ============ BSL CORE (Python) ============
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_HOST=http://ollama:11434

# BSL-specific
BSL_API_KEY=bsl-local-dev-key
FLASK_ENV=development

# ============ BRAIN AGENT (Node.js) ============
BRAIN_PORT=30000
CONFIG_PATH=/app/operating_system
SQLITE_PATH=/app/data/bakerst.db

# Model routing
AGENT_MODEL=anthropic/claude-3-opus-20240229
CONV_MODEL=openai/gpt-3.5-turbo
OBSERVER_MODEL=openai/gpt-4o-mini
REFLECTOR_MODEL=anthropic/claude-3-sonnet-20240229

# ============ SERVICES ============
BSL_API_URL=http://bsl-api:5000
NATS_URL=nats://nats:4222
QDRANT_URL=http://qdrant:6333

# ============ GATEWAY ============
GATEWAY_PORT=8080
ALLOWED_ORIGINS=*

# Telegram (optional)
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_IDS=...

# Discord (optional)
DISCORD_BOT_TOKEN=...
DISCORD_CHANNEL_IDS=...
